      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (job, status) (rate(http_server_requests_seconds_count{job=~\"$job\"}[1m]))",
          "legendFormat": "{{job}} [{{status}}]",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
